node_modules/
data.db
data.db-journal
.env
www/

# Local tooling / secrets. These lines were previously UTF-16 encoded, so git
# never matched them and start-chess.ps1 (which holds a GitHub token) was
# showing up as committable.
start-chess.ps1
gh-auth-*.txt
patch*.js
Chess-AmKh-debug.apk
apk-verification/
README-ANDROID.md

# نسخة لينكس من ngrok (باينري 32MB، بيتنزّل محليًا، مش بيتّبع)
ngrok

.claude/settings.local.json
.tmp-cdp/
.chrome-prof/
_shot_*.png
_run.js
_shoot.js
_t7*.js
_g*.js
*.tmp-cdplog.txt
.claude/

# APKs now ship as GitHub Release assets, not repo blobs
*.apk

# محرّك الشبكة الكبيرة (Stockfish الكامل، ~108MB): أكبر من حدّ GitHub الصارم
# (100MB لكل ملف) — لو اترفع لـgit هيترفض الـpush. بيتضمّن في الـAPK من نسخة
# الشغل مباشرة (مش محتاج يكون في الريبو)، ونسخة lite الأخف المتتبَّعة تكفي كسقوط.
stockfish-18-single.wasm

# بروفايل المتصفح المستخدم في القياس بـCDP
.chrome-prof-w/

# نسخ احتياطية من قاعدة البيانات — فيها بيانات مستخدمين (إيميلات، google_uid).
# ممنوع تمامًا ترفع لـgit.
data.db.bak*
*.db.bak*

# توكِنات FCM للإشعارات مربوطة بحسابات المستخدمين — بيانات حساسة، ممنوع ترفع لـgit.
tokens.json

# cloudflared: مش أداة النفق بتاعتنا (بنستخدم ngrok)، وباينري لينكس ممنوع يترفع.
cloudflared
cloudflared*

# مفاتيح توقيع أندرويد (رفع Google Play) — أسرار، ممنوع ترفع لـgit إطلاقًا.
*.jks
*.keystore
keystore.properties
key.properties

# لوجات وملفات مؤقتة محلية
logs/
tunnel.out
tunnel.err
.fuse_hidden*
git-push.bat
kill-all.bat
start-all.bat
*.aab

# ملفات تشخيص وقياس محلية (كلها ببادئة _) + بروفايل المتصفح بتاع القياس
_*
.chrome-prof-kb/

# فولدر تسليم Google Play (بناء + صور المتجر) — مايتحفظش في المستودع
play-store/
