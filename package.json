{
  "name": "chess-amkh-server",
  "version": "1.4.0",
  "description": "WebSocket server for شطرنج Am-Kh",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:web": "node scripts/build-web.js",
    "cap:sync": "npm run build:web && cap sync android",
    "cap:open": "npm run build:web && cap open android",
    "assets:android": "capacitor-assets generate --android --assetPath assets --iconBackgroundColor #0a0a14 --iconBackgroundColorDark #0a0a14 --splashBackgroundColor #0a0a14 --splashBackgroundColorDark #0a0a14"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.2.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/push-notifications": "^8.1.2",
    "@capgo/capacitor-social-login": "^8.4.3",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "chess.js": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^10.9.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.1.7",
    "qs": "^6.16.0",
    "ws": "^8.17.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "esbuild": "^0.28.1"
  },
  "overrides": {
    "express": {
      "qs": "^6.16.1"
    },
    "@capacitor/assets": {
      "sharp": "^0.35.5",
      "@capacitor/cli": "^8.4.2"
    },
    "xcode": {
      "uuid": "^11.1.1"
    },
    "tar": "^7.5.21"
  }
}
