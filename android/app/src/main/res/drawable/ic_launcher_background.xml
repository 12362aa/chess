<!-- خلفية أيقونة المُشغِّل: نفس تدرّج icon.png (كحلي غامق ← بنفسجي).
     كانت قبل كده صورة mipmap مسطّحة مع inset ‏16.7% فتُترك الأركان فاضية،
     والقالب الافتراضي (تركوازي بشبكة) كان لسه موجودًا في المشروع. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#061336"
        android:centerColor="#1B1748"
        android:endColor="#391D6A" />
</shape>
